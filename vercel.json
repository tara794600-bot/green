{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/render.js": { "includeFiles": "{dist,dist-server}/**" } },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/handler?__route=sitemap" },
    { "source": "/api/render", "destination": "/api/render" },
    { "source": "/api/:path*", "destination": "/api/handler?__route=:path*" },
    {
      "source": "/((?!api/|assets/|images/|naran.svg|favicon.svg|robots.txt).*)",
      "destination": "/api/render?path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
